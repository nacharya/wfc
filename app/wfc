#!/usr/bin/env python
import warnings
warnings.filterwarnings("ignore")

import sys
import getopt
import platform
import os
from os.path import expanduser
import json

from datetime import datetime, timedelta
import datetime as dtt

import asyncio
import aiofiles

import logzero
from logzero import logger
from logzero import logging

from wfc_config import wfc_config
from wfc_ds import wfc_dgather, wfc_dpredict, wfc_dclean, wfc_visual, StockNow
from wfc_news import wfc_feed

DEFAULT_CONFIG = "/.wfc"


def usage():
    print(sys.argv[0] + " --help | --system")
    print(sys.argv[0] + " [ --debug <level> ] <command> [args]")
    print()
    print("Commands:")
    print("  list")
    print("  ticker <portfolio>  [list | add <TICKER> | del <TICKER>]")
    print("  gather  <portfolio> <start_date> <end_date>        # YYYY-MM-DD")
    print("  predict <ticker>    <YYYY-MM-DD | days>")
    print("  show    <ticker>    [closing | volume | daily | now]")
    print("  owned   [add | del] <ticker> <date> [<shares> <price>]")
    print("  news    [<ticker> | owned]")
    print("  oa      [<days>]   # overall analysis, default 14 days")
    print("  clean")


def system_info(debug_level):
    print("python   : " + platform.python_version())
    print("platform : " + platform.node() + " " + platform.system() + " " + platform.machine())
    print("debug    : " + str(debug_level))


# ------------------------------------------------------------------ commands

async def wfc_list(args, cfg):
    cfg.show()


async def wfc_ticker(args, cfg, sfile):
    if len(args) < 1:
        logger.error("ticker <portfolio> [list|add <TICKER>|del <TICKER>]")
        return
    pf_name = args[0]
    if pf_name not in cfg.pf_dict:
        logger.error(f"Portfolio not found: {pf_name}")
        return
    sub = args[1] if len(args) > 1 else "list"
    if sub == "list":
        print(f"{pf_name}: {', '.join(cfg.pf(pf_name).tickers())}")
    elif sub == "add" and len(args) > 2:
        ticker = args[2].upper()
        cfg.ticker_add(pf_name, ticker)
        cfg.save(sfile)
        print(f"Added {ticker} to {pf_name}")
    elif sub == "del" and len(args) > 2:
        ticker = args[2].upper()
        cfg.ticker_del(pf_name, ticker)
        cfg.save(sfile)
        print(f"Removed {ticker} from {pf_name}")
    else:
        logger.error("ticker <portfolio> [list|add <TICKER>|del <TICKER>]")


async def wfc_owned(args, cfg, sfile):
    cfg.owned(args)
    cfg.save(sfile)


async def wfc_gather(args, cfg):
    if len(args) < 3:
        logger.error("gather <portfolio> <start_date> <end_date>  (YYYY-MM-DD)")
        return
    pf_name    = args[0]
    start_date = args[1]
    end_date   = args[2]
    pf = cfg.pf(pf_name)
    wfc_dgather(pf.tickers(), start_date, end_date).gather(cfg.data_location())


async def wfc_predict(args, cfg):
    if len(args) < 2:
        logger.error("predict <ticker> <YYYY-MM-DD | days>")
        return
    tkr_name   = args[0]
    future_arg = args[1]

    # Accept integer days or an explicit date string
    if future_arg.isdigit():
        future_date = (dtt.datetime.now() + timedelta(days=int(future_arg))).strftime("%Y-%m-%d")
    else:
        future_date = future_arg

    current = StockNow(tkr_name).get('Close')
    predictor = wfc_dpredict(cfg, tkr_name, future_date)
    results = predictor.predict()

    if not results:
        logger.error(f"No results for {tkr_name}")
        return

    print(f"\n{tkr_name} — Prediction for {future_date}")
    if current:
        print(f"Current price: ${current:.2f}\n")
    header = f"{'Algorithm':<22} {'Predicted':>10} {'Change':>8} {'R²':>7} {'RMSE':>8} {'MAE':>7}"
    print(header)
    print("-" * len(header))
    for algo in ["linear", "gbr", "rfr"]:
        if algo not in results:
            continue
        r = results[algo]
        chg = f"{((r['price'] - current) / current * 100):+.1f}%" if current else "N/A"
        print(f"{r['label']:<22} ${r['price']:>9.2f} {chg:>8} {r['r2']:>7.3f} {r['rmse']:>8.2f} {r['mae']:>7.2f}")
    if 'ensemble' in results:
        e = results['ensemble']
        chg = f"{((e['price'] - current) / current * 100):+.1f}%" if current else "N/A"
        print("-" * len(header))
        print(f"{'Ensemble':<22} ${e['price']:>9.2f} {chg:>8}")


async def wfc_show(args, cfg):
    if len(args) < 1:
        logger.error("show <ticker> [closing | volume | daily | now]")
        return
    ticker = args[0]
    cmd    = args[1] if len(args) > 1 else "closing"
    vs = wfc_visual(cfg, ticker)
    if cmd == "now":
        price = vs.now('Close')
        print(f"{ticker}\t${price:.2f}" if price else f"{ticker}\tN/A")
    else:
        vs.execute(cmd)


async def wfc_clean(args, cfg):
    wfc_dclean(cfg).execute()


async def wfc_news(args, cfg):
    if len(args) < 1:
        logger.error("news [<ticker> | owned]")
        return
    if args[0] == "owned":
        tickers = [x['ticker'] for x in cfg.purchased]
    else:
        tickers = [args[0]]
    for tkr in tickers:
        feed = wfc_feed(tkr)
        feed.get_news()
        feed.show_summary(tkr)


async def wfc_oa(args, cfg):
    days = 14
    if args:
        try:
            days = int(args[0])
        except ValueError:
            pass
    today      = dtt.datetime.now()
    today_str  = today.strftime("%Y-%m-%d")
    future_str = (today + timedelta(days=days)).strftime("%Y-%m-%d")

    print(f"Overall Analysis: {today_str}  →  {future_str} ({days} days)")
    print("=" * 70)

    for x in cfg.purchased:
        tkr_name = x['ticker']
        print(f"\n{tkr_name}")
        for i in x['ticker_purchase']:
            for date, details in i.items():
                count, price = details[0], details[1]
                print(f"  Bought {count} shares @ ${price:.2f} on {date}")

        current = StockNow(tkr_name).get('Close')
        if current:
            print(f"  Current:    ${current:.2f}")

        try:
            results = wfc_dpredict(cfg, tkr_name, future_str).predict()
            if 'ensemble' in results:
                ens = results['ensemble']['price']
                chg = f"{((ens - current) / current * 100):+.1f}%" if current else "N/A"
                print(f"  Prediction: ${ens:.2f} ({chg}) by {future_str}")
        except Exception as e:
            print(f"  Prediction: unavailable ({e})")

        try:
            feed = wfc_feed(tkr_name)
            feed.get_news()
            if feed.articles:
                overall = feed.overall_sentiment()
                pos, neg, neu = feed.get_pos(), feed.get_neg(), feed.get_neu()
                print(f"  Sentiment:  {overall.upper()} (+{pos:.2f} / -{neg:.2f} / ~{neu:.2f})")
        except Exception as e:
            logger.warning(f"News failed for {tkr_name}: {e}")


# ------------------------------------------------------------------ dispatch

async def process_command(cmd, args, cfg_file):
    valid_cmds = ["list", "ticker", "gather", "predict", "show", "clean",
                  "owned", "news", "oa"]
    if cmd not in valid_cmds:
        logger.error(f"Unknown command: {cmd}")
        return

    async with aiofiles.open(cfg_file, mode='r') as f:
        cfg = wfc_config(await f.read())

    if   cmd == "list":    await wfc_list(args, cfg)
    elif cmd == "ticker":  await wfc_ticker(args, cfg, cfg_file)
    elif cmd == "owned":   await wfc_owned(args, cfg, cfg_file)
    elif cmd == "gather":  await wfc_gather(args, cfg)
    elif cmd == "predict": await wfc_predict(args, cfg)
    elif cmd == "show":    await wfc_show(args, cfg)
    elif cmd == "clean":   await wfc_clean(args, cfg)
    elif cmd == "news":    await wfc_news(args, cfg)
    elif cmd == "oa":      await wfc_oa(args, cfg)


def main():
    assert sys.version_info >= (3, 7)

    debug_level = 5
    try:
        opts, remainder = getopt.getopt(sys.argv[1:], "hd:s", ["help", "debug=", "system"])
    except getopt.GetoptError:
        usage()
        sys.exit(2)

    for o, a in opts:
        if o in ("-h", "--help"):
            usage()
            sys.exit(0)
        if o in ("-d", "--debug"):
            debug_level = int(a)
        if o in ("-s", "--system"):
            system_info(debug_level)
            sys.exit(0)

    if not remainder:
        usage()
        sys.exit(2)

    if debug_level == 0:
        fmt = '%(color)s[%(levelname)1.1s %(asctime)s %(module)s:%(lineno)d]%(end_color)s %(message)s'
        logzero.logfile(sys.argv[0] + ".log", maxBytes=1048576, backupCount=3,
                        loglevel=logging.DEBUG,
                        formatter=logzero.LogFormatter(fmt=fmt))
        logzero.setup_default_logger(level=logging.DEBUG,
                                     formatter=logzero.LogFormatter(fmt=fmt))
    else:
        logzero.setup_default_logger(level=logging.INFO,
                                     formatter=logzero.LogFormatter(fmt='%(message)s'))

    cfg_file = expanduser("~") + DEFAULT_CONFIG
    if not os.path.isfile(cfg_file) or not os.access(cfg_file, os.R_OK):
        logger.error(f"Config not found: {cfg_file}")
        sys.exit(2)

    loop = asyncio.get_event_loop()
    loop.run_until_complete(
        asyncio.gather(asyncio.ensure_future(
            process_command(remainder[0], remainder[1:], cfg_file)
        ))
    )
    loop.close()


if __name__ == '__main__':
    main()
